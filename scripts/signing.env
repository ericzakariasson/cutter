# Shared by setup-signing.sh and build-app.sh.
#
# Why Cutter is signed
#
# macOS ties the Accessibility permission to an app's code signature. An unsigned ("ad-hoc")
# build gets a new signature every time, so the permission would have to be granted again
# after each rebuild. Signing every build with the same certificate keeps it.
#
# The certificate is self-signed and lives in a keychain of its own under SIGNING_DIR.
# codesign only finds certificates in keychains on the user's search list, so the scripts
# run it with HOME set to SIGNING_HOME, whose search list holds just this keychain. Your
# login keychain and your real keychain search list are never touched.
#
# What this costs in security
#
# The keychain password below is not a secret: it is written in this file, the same for
# everyone who builds Cutter. The keychain also never locks. So ANY PROCESS RUNNING AS YOU
# can sign a program of its choice as "Cutter Local Signing" with Cutter's bundle
# identifier, and macOS will then treat that program as Cutter: once you have granted
# Cutter Accessibility access, the program has it too, without a prompt. Accessibility
# access lets a program read and control every app's windows and send them input.
#
# Without this certificate, such a process would have to get you to grant it access
# itself. With it, the grant you gave Cutter is the grant. That is the price of not being
# asked again after each rebuild. It does not help an attacker who cannot already run
# code as you, and the certificate is trusted for nothing else.
#
# If you do not want that trade-off, build with CUTTER_SIGNING=adhoc (and grant access
# again after every build), and delete SIGNING_DIR.
SIGNING_IDENTITY="Cutter Local Signing"
SIGNING_DIR="$HOME/Library/Application Support/Cutter/signing"
SIGNING_KEYCHAIN="$SIGNING_DIR/cutter-signing.keychain-db"
SIGNING_KEYCHAIN_PASSWORD="cutter-local-signing"
SIGNING_HOME="$SIGNING_DIR/home"

# The release key
#
# Releases, the DMGs other people download, are NOT signed with the key above. Its
# password is public, so a copy of that keychain file would be enough to sign as Cutter,
# and macOS would hand whatever was signed the Accessibility access people gave Cutter.
#
# scripts/setup-release-key.sh makes a second key for releases, in a keychain locked with
# a passphrase that is typed in and stored nowhere. scripts/make-dmg.sh asks for the
# passphrase, signs, and locks the keychain again. Without the passphrase the keychain
# file is useless. Keep a backup of RELEASE_SIGNING_DIR and remember the passphrase: a
# release signed with any other key makes everyone grant Accessibility access again.
#
# CUTTER_RELEASE_SIGNING_DIR points the scripts at another folder, for trying them out
# with a throwaway key.
RELEASE_SIGNING_IDENTITY="Cutter Release Signing"
RELEASE_SIGNING_DIR="${CUTTER_RELEASE_SIGNING_DIR:-$HOME/Library/Application Support/Cutter/release-signing}"
RELEASE_SIGNING_KEYCHAIN="$RELEASE_SIGNING_DIR/cutter-release.keychain-db"
RELEASE_SIGNING_HOME="$RELEASE_SIGNING_DIR/home"

# Reads a passphrase into the variable `passphrase`: typed without echo at a terminal, or
# one line of standard input otherwise.
read_passphrase() {
    if [ -t 0 ]; then
        IFS= read -rs -p "$1" passphrase
        echo >&2
    else
        IFS= read -r passphrase
    fi
}

# Runs one `security` command without its arguments appearing on a command line, where
# `ps` would show a passphrase to every process on the Mac. The command is sent to
# `security -i`, which reads commands from its standard input.
security_unseen() {
    local line="" argument
    for argument in "$@"; do
        argument="${argument//\\/\\\\}"
        argument="${argument//\"/\\\"}"
        line+="\"$argument\" "
    done
    printf '%s\n' "$line" | security -i
}
